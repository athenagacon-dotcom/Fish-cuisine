 panel.querySelectorAll("[data-delete-recipe]").forEach(b=>b.onclick=async()=>{if(!confirm("Supprimer cette recette ?"))return;const {error}=await supabase.from("recipes").delete().eq("id",b.dataset.deleteRecipe);if(error)return toast(error.message);await loadData();render();renderAdminPanel()});
 }
}
$("#ingredient-search").addEventListener("input",renderIngredients);$("#category-filter").addEventListener("change",renderIngredients);
$("#recipe-category").addEventListener("change",renderRecipes);$("#match-mode").addEventListener("change",renderRecipes);
