 const panel=$("#admin-panel");if(!panel)return;
 const logged=!!supabase;
 if(adminTab==="ingredients"){
 panel.innerHTML=`<h3>Ajouter un ingrédient</h3><div class="form-grid"><div class="field"><label>Nom</label><input id="new-ing-name" placeholder="Ex. Aubergine"></div><div class="field"><label>Catégorie</label><input id="new-ing-cat" placeholder="Légumes"></div><div class="field"><label>Emoji</label><input id="new-ing-emoji" placeholder="🍆"></div></div><button class="btn" id="save-ing">Enregistrer l'ingrédient</button><div class="admin-list">${ingredients.map(i=>`<div class="admin-item"><span>${esc(i.emoji||"🌿")} ${esc(i.name)} <small>· ${esc(i.category||"")}</small></span><button data-delete-ing="${esc(i.id)}">Supprimer</button></div>`).join("")}</div>`;
 $("#save-ing").onclick=async()=>{const name=$("#new-ing-name").value.trim();if(!name)return toast("Indiquez un nom.");if(!supabase)return toast("Configurez Supabase pour enregistrer.");const {data:{user}}=await supabase.auth.getUser();if(!user)return toast("Connectez-vous d'abord.");const {error}=await supabase.from("ingredients").insert({name,category:$("#new-ing-cat").value,emoji:$("#new-ing-emoji").value,user_id:user.id});if(error)return toast(error.message);await loadData();render();renderAdminPanel();toast("Ingrédient ajouté.")};
 panel.querySelectorAll("[data-delete-ing]").forEach(b=>b.onclick=async()=>{if(!confirm("Supprimer cet ingrédient ?"))return;const {error}=await supabase.from("ingredients").delete().eq("id",b.dataset.deleteIng);if(error)return toast(error.message);await loadData();render();renderAdminPanel()});
 }else{
 panel.innerHTML=`<h3>Ajouter une recette</h3><div class="form-grid"><div class="field"><label>Nom de la recette</label><input id="r-title" placeholder="Ex. Soupe de saison"></div><div class="field"><label>Catégorie</label><input id="r-cat" placeholder="Plat, dessert…"></div><div class="field"><label>Temps (minutes)</label><input id="r-time" type="number" value="30"></div><div class="field"><label>Nombre de personnes</label><input id="r-servings" type="number" value="2" min="1"></div><div class="field"><label>Coût total estimé (€)</label><input id="r-cost" type="number" step=".01" value="3"></div><div class="field"><label>Calories par personne</label><input id="r-cal" type="number" value="450"></div><div class="field"><label>Protéines par personne (g)</label><input id="r-protein" type="number" value="15"></div><div class="field"><label>Emoji (ou image à ajouter plus tard)</label><input id="r-emoji" value="🍲"></div><div class="field wide"><label>Description</label><textarea id="r-desc"></textarea></div><div class="field wide"><label>Préparation (une étape par ligne)</label><textarea id="r-steps"></textarea></div><div class="field wide"><label>Ingrédients et quantités</label><div class="notice">Choisissez un ingrédient, saisissez sa quantité et son unité, puis cliquez sur « Ajouter à la recette ».</div><div class="form-grid"><select id="r-ing"><option value="">Choisir un ingrédient</option>${ingredients.map(i=>`<option value="${esc(i.id)}">${esc(i.name)}</option>`).join("")}</select><input id="r-qty" type="number" step=".1" placeholder="Quantité"><input id="r-unit" placeholder="g, ml, pièce…"></div><button id="add-ri" class="btn secondary">Ajouter à la recette</button><div id="recipe-items" class="admin-list"></div></div></div><button id="save-recipe" class="btn">Enregistrer la recette</button><div class="admin-list">${recipes.map(r=>`<div class="admin-item"><span>${esc(r.emoji||"🍲")} ${esc(r.title)}</span><button data-delete-recipe="${esc(r.id)}">Supprimer</button></div>`).join("")}</div>`;
 let chosen=[];
 const draw=()=>$("#recipe-items").innerHTML=chosen.map(x=>`<div class="admin-item"><span>${esc(ingredients.find(i=>String(i.id)===String(x.id))?.name||"")} — ${x.quantity} ${esc(x.unit)}</span><button data-rm="${x.id}">Retirer</button></div>`).join("");
 $("#add-ri").onclick=()=>{const id=$("#r-ing").value,quantity=Number($("#r-qty").value),unit=$("#r-unit").value;if(!id||!quantity)return toast("Choisissez un ingrédient et une quantité.");chosen.push({id,quantity,unit});draw()};
 $("#recipe-items").addEventListener("click",e=>{if(e.target.dataset.rm){chosen=chosen.filter(x=>String(x.id)!==e.target.dataset.rm);draw()}});
