async function connect(){
 if(!SUPABASE_URL.startsWith("https://")||SUPABASE_ANON_KEY.includes("COLLER_")){demoData();return false}
 try{const {createClient}=await import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm");supabase=createClient(SUPABASE_URL,SUPABASE_ANON_KEY);await loadData();return true}
 catch(e){console.error(e);demoData();toast("Connexion à la base impossible : affichage en mode démonstration.");return false}
}
async function loadData(){
 const [ir,rr]=await Promise.all([supabase.from("ingredients").select("*").order("name"),supabase.from("recipes").select("*, recipe_ingredients(ingredient_id, quantity, unit, ingredients(name, emoji))").order("title")]);
 if(ir.error||rr.error)throw(ir.error||rr.error);
 ingredients=ir.data;recipes=rr.data.map(r=>({...r,items:(r.recipe_ingredients||[]).map(x=>[x.ingredient_id,x.quantity,x.unit,x.ingredients?.name])}));
}
function render(){
 const cats=[...new Set(ingredients.map(i=>i.category).filter(Boolean))];
 $("#category-filter").innerHTML='<option value="">Toutes les catégories</option>'+cats.map(c=>`<option>${esc(c)}</option>`).join("");
 $("#recipe-category").innerHTML='<option value="">Toutes les catégories</option>'+[...new Set(recipes.map(r=>r.category))].map(c=>`<option>${esc(c)}</option>`).join("");
 renderIngredients();renderRecipes();
}
function renderIngredients(){
 const q=$("#ingredient-search").value.toLowerCase(),cat=$("#category-filter").value;
 $("#ingredient-chips").innerHTML=ingredients.filter(i=>i.name.toLowerCase().includes(q)&&(!cat||i.category===cat)).map(i=>`<button class="chip ${selected.has(i.id)?"active":""}" data-ing="${esc(i.id)}">${esc(i.emoji||"🌿")} ${esc(i.name)}</button>`).join("");
 $("#selected-count").textContent=`${selected.size} ingrédient${selected.size>1?"s":""} sélectionné${selected.size>1?"s":""}`;
}
function renderRecipes(){
 const cat=$("#recipe-category").value,mode=$("#match-mode").value;
 const list=recipes.filter(r=>{
  if(cat&&r.category!==cat)return false;
  if(!selected.size)return true;
  const ids=r.items.map(x=>String(x[0]));
  return mode==="all"?[...selected].every(id=>ids.includes(id)):ids.some(id=>selected.has(id));
 });
 $("#recipe-grid").innerHTML=list.map(r=>`<article class="recipe-card" data-recipe="${esc(r.id)}"><div class="recipe-visual">${r.image_url?`<img src="${esc(r.image_url)}" alt="">`:esc(r.emoji||"🍲")}<span class="recipe-tag">${esc(r.category||"Recette")}</span></div><div class="recipe-body"><h3>${esc(r.title)}</h3><p>${esc(r.description||"Une recette maison à découvrir.")}</p><div class="recipe-meta"><span>◷ ${r.time||0} min</span><span>♧ ${r.servings||2} pers.</span><span>${money(r.cost)}</span></div></div></article>`).join("");
 $("#empty-recipes").classList.toggle("hidden",list.length>0);
}
function showRecipe(id){
 const r=recipes.find(x=>String(x.id)===String(id));if(!r)return;
 const factor=Number($("#people-count")?.value)||r.servings||2;
 const lines=r.items.map(x=>{const ing=ingredients.find(i=>String(i.id)===String(x[0]));return `<div class="ingredient-line"><span>${esc(ing?.emoji||"🌿")} ${esc(ing?.name||x[3]||"Ingrédient")}</span><b>${fmtQty((Number(x[1])||0)*factor/(r.servings||2))} ${esc(x[2]||"")}</b></div>`}).join("");
 $("#recipe-detail").innerHTML=`<div class="detail-hero">${r.image_url?`<img src="${esc(r.image_url)}" style="width:100%;height:100%;object-fit:cover">`:esc(r.emoji||"🍲")}</div><p class="eyebrow">${esc(r.category||"RECETTE")}</p><h2 class="detail-title">${esc(r.title)}</h2><p>${esc(r.description||"")}</p><div class="detail-meta"><span>◷ ${r.time||0} min</span><span>Coût estimé : ${money(r.cost)}</span></div><label class="field">Nombre de personnes<input id="people-count" type="number" min="1" max="30" value="${r.servings||2}"></label><div class="detail-columns"><div><h3>Ingrédients</h3><div id="detail-ingredients">${lines}</div><p><b>Coût estimé :</b> ${money((Number(r.cost)||0)*factor/(r.servings||2))}</p><p><b>Nutrition / personne :</b><br>${Math.round((r.calories||0)*factor/(r.servings||2))} kcal · ${Math.round((r.protein||0)*factor/(r.servings||2))} g protéines</p><button id="shopping-add" class="btn">Ajouter à ma liste de courses</button></div><div><h3>Préparation</h3><p style="white-space:pre-line;line-height:1.8;font-size:13px">${esc(r.steps||"Préparation à compléter.")}</p></div></div>`;
 $("#people-count").addEventListener("input",()=>showRecipe(id));
 $("#shopping-add").addEventListener("click",()=>{const items=r.items.map(x=>{const ing=ingredients.find(i=>String(i.id)===String(x[0]));return `${fmtQty(Number(x[1])*factor/(r.servings||2))} ${x[2]||""} ${ing?.name||x[3]||""}`});const txt=`Liste de courses – ${r.title}\n${items.join("\n")}`;navigator.clipboard?.writeText(txt).then(()=>toast("Liste de courses copiée !")).catch(()=>toast(items.join(" · ")))});
 $("#recipe-modal").classList.remove("hidden");
}
function fmtQty(n){return Number.isInteger(n)?n:(Math.round(n*100)/100).toString().replace(".",",")}
function openAdmin(){ $("#admin-modal").classList.remove("hidden");renderAdmin()}
function renderAdmin(){
 const configured=!!supabase;
 $("#admin-content").innerHTML=`<p class="eyebrow">VOTRE ESPACE PERSONNEL</p><h2>Administration</h2>${!configured?'<div class="notice">Mode aperçu : les exemples sont visibles, mais l’enregistrement des modifications nécessite de configurer Supabase (étapes dans le guide).</div>':""}
 <div id="auth-area"></div><div class="admin-tabs"><button data-tab="recipes" class="${adminTab==="recipes"?"active":""}">Recettes</button><button data-tab="ingredients" class="${adminTab==="ingredients"?"active":""}">Ingrédients</button></div><div id="admin-panel"></div>`;
 if(configured)renderAuth();renderAdminPanel();
}
async function renderAuth(){
 const {data:{session}}=await supabase.auth.getSession();
 $("#auth-area").innerHTML=session?`<div class="notice">Connecté : ${esc(session.user.email)} <button id="logout" class="text-btn">Se déconnecter</button></div>`:`<div class="form-grid"><div class="field"><label>Adresse e-mail</label><input id="auth-email" type="email" placeholder="vous@exemple.fr"></div><div class="field"><label>Mot de passe</label><input id="auth-password" type="password" placeholder="8 caractères minimum"></div></div><div class="admin-actions"><button id="login" class="btn">Se connecter</button><button id="signup" class="btn secondary">Créer mon compte</button></div><div class="notice">Créez votre compte la première fois. L'accès est protégé par Supabase Auth.</div>`;
 $("#login")?.addEventListener("click",()=>authAction("login"));$("#signup")?.addEventListener("click",()=>authAction("signup"));
 $("#logout")?.addEventListener("click",async()=>{await supabase.auth.signOut();renderAdmin()});
}
async function authAction(action){
 const email=$("#auth-email").value,password=$("#auth-password").value;if(!email||password.length<8){toast("Saisissez un e-mail et un mot de passe (8 caractères minimum).");return}
 const res=action==="signup"?await supabase.auth.signUp({email,password}):await supabase.auth.signInWithPassword({email,password});
 if(res.error){toast(res.error.message);return}toast(action==="signup"?"Compte créé. Vérifiez votre e-mail si demandé.":"Connexion réussie.");await loadData();render();renderAdmin();
}
